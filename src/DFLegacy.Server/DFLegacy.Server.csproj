<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>DFLegacy.Server.ico</ApplicationIcon>
    <RandomNativeBinary>$(MSBuildProjectDirectory)\..\..\artifacts\native\random\$(Configuration)\DFLegacy.RandomNative.dll</RandomNativeBinary>
    <BuildRandomNativeReference Condition="'$(MSBuildRuntimeType)' == 'Full' and ('$(BuildingSolutionFile)' == 'true' or '$(BuildingInsideVisualStudio)' == 'true')">true</BuildRandomNativeReference>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <ProjectReference Include="../DFLegacy.Protocol/DFLegacy.Protocol.csproj" />
    <ProjectReference Include="../DFLegacy.RandomNative/DFLegacy.RandomNative.vcxproj"
                      ReferenceOutputAssembly="false"
                      Condition="'$(BuildRandomNativeReference)' == 'true'" />
    <Content Include="../../server.json" Link="server.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(RandomNativeBinary)"
             Link="DFLegacy.RandomNative.dll"
             Condition="Exists('$(RandomNativeBinary)') or '$(BuildRandomNativeReference)' == 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
